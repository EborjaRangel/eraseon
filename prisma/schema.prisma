generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAPTURISTA
}

enum PhotoKind {
  ANTES
  DESPUES
}

enum TipoBarda {
  PUBLICA
  PRIVADA
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CAPTURISTA)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  bardas    Barda[]
}

model Barda {
  id          String   @id @default(cuid())
  consecutivo Int      @unique
  address     String
  latitude    Float
  longitude   Float
  altoMetros  Float
  anchoMetros Float
  areaM2      Float
  tipo        TipoBarda @default(PUBLICA)
  notes       String    @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  photos      Photo[]

  @@index([createdById])
}

model Photo {
  id        String    @id @default(cuid())
  url       String
  data      Bytes
  kind      PhotoKind
  slot      Int
  bardaId   String
  barda     Barda     @relation(fields: [bardaId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([bardaId, kind, slot])
  @@index([bardaId])
}
